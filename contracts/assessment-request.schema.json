{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.example/contracts/assessment-request.schema.json",
  "title": "Pharos Security Assessment Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "targetType", "target"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assessmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "targetType": {
      "enum": ["SKILL", "CONTRACT", "ADDRESS", "FULL"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "network": { "enum": ["mainnet", "testnet"] },
        "skillRef": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offline": { "type": "boolean" },
        "deadlineMs": { "type": "integer", "minimum": 100, "maximum": 60000 }
      }
    }
  }
}
