{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.example/contracts/assessment-result.schema.json",
  "title": "Pharos Security Assessment Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessmentId",
    "targetType",
    "status",
    "findings",
    "evidence",
    "warnings",
    "confidence",
    "timing",
    "source",
    "details"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assessmentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "targetType": { "enum": ["SKILL", "CONTRACT", "ADDRESS", "FULL"] },
    "status": { "enum": ["COMPLETE", "PARTIAL", "TIMEOUT", "FAILED"] },
    "risk": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["score", "level"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": {
          "enum": ["LOW", "MEDIUM", "MODERATE", "ELEVATED", "HIGH", "CRITICAL"]
        }
      }
    },
    "findings": { "type": "array", "items": {} },
    "evidence": { "type": "array", "items": {} },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "confidence": { "enum": ["FULL", "PARTIAL", "UNKNOWN"] },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "durationMs"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "version"],
      "properties": {
        "module": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "details": {}
  }
}
